      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q12 · Nernst: MnO₄⁻/Mn²⁺ vs AgCl/Ag",
        "problem": "Ag | AgCl | Cl$^-$ (0.0250 M) ‖ MnO$_4^-$ (0.0100 M), Mn$^{2+}$ (0.00200 M), pH 2.30 | Pt at 298.15 K. (a) $E^\\circ$(AgCl/Ag) (b) $E_{cell}$ (c) $\\Delta G$ for 5 e⁻.",
        "steps": [
          {
            "id": "q12-sol-s01",
            "math": "\\frac{8.314462\\cdot298.15}{96485.33}\\ln 10 \\approx 0.0591593",
            "note": "(RT/F) ln 10 in volts."
          },
          {
            "id": "q12-sol-s02",
            "math": "0.7996+0.0591593\\log_{10}\\left(1.80\\times10^{-10}\\right) \\approx 0.223108",
            "note": "(a) E°(AgCl/Ag) = E°(Ag⁺/Ag) + (RT/F) ln 10 · log K_sp."
          },
          {
            "id": "q12-sol-s03",
            "math": "1.512-\\frac{0.0591593}{5}\\log_{10}\\frac{0.00200}{0.0100\\cdot\\left(10^{-2.30}\\right)^{8}} \\approx 1.30256",
            "note": "Cathode: MnO₄⁻ + 8H⁺ + 5e⁻ → Mn²⁺ + 4H₂O."
          },
          {
            "id": "q12-sol-s04",
            "math": "0.223108-0.0591593\\log_{10}(0.0250) \\approx 0.317885",
            "note": "Anode couple: AgCl + e⁻ → Ag + Cl⁻ at [Cl⁻] = 0.0250 M."
          },
          {
            "id": "q12-sol-s05",
            "math": "1.30256-0.317885 \\approx 0.98468",
            "note": "(b) E_cell = E_cathode − E_anode."
          },
          {
            "id": "q12-sol-s06",
            "math": "1.288892-\\frac{0.0591593}{5}\\log_{10}\\frac{0.00200}{0.0100\\cdot10^{-18.4}\\cdot0.0250^{5}} \\approx 0.98468",
            "note": "Same result from E°cell = 1.512 − 0.2231 and the overall Q = [Mn²⁺]/([MnO₄⁻][H⁺]⁸[Cl⁻]⁵), n = 5; [H⁺]⁸ = 10^(−18.4)."
          },
          {
            "id": "q12-sol-s07",
            "math": "\\frac{-5\\cdot96485.33\\cdot0.984679}{1000} \\approx -475.04",
            "note": "(c) ΔG = −nFE_cell in kJ mol⁻¹."
          },
          {
            "id": "q12-sol-s08",
            "math": "\\frac{5\\left(1.512-0.223108\\right)}{0.0591593} \\approx 108.9",
            "note": "log K = nE°cell/((RT/F) ln 10): the reaction is overwhelmingly favourable."
          }
        ],
        "answer": "E^\\circ_{\\mathrm{AgCl/Ag}}=0.2231\\ \\mathrm V;\\quad E_{cell}=0.985\\ \\mathrm V;\\quad \\Delta G=-475\\ \\mathrm{kJ\\,mol^{-1}}",
        "source": {
          "kind": "manual"
        }
      }
    },
