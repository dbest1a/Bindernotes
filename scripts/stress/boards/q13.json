{
  "question": 13,
  "title": "Q13 van 't Hoff N2O4",
  "subject": "Chemistry",
  "modules": [
    {
      "id": "q13-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q13 · N₂O₄ ⇌ 2 NO₂ (van 't Hoff)",
        "problem": "$K^\\circ=0.1420$ at 298.15 K, $\\Delta H^\\circ=+58.30$ kJ/mol. (a) $T$ where $K^\\circ=1$ (b) $K^\\circ$(340.0 K) (c) 0.400 bar N$_2$O$_4$ at 340.0 K: total pressure and fraction dissociated.",
        "steps": [
          {
            "id": "q13-sol-s01",
            "math": "\\left(\\frac{1}{298.15}-\\frac{8.314462\\ln(1/0.1420)}{58300}\\right)^{-1} \\approx 325.135",
            "note": "(a) ln(K₂/K₁) = −(ΔH°/R)(1/T₂ − 1/T₁) with K₂ = 1."
          },
          {
            "id": "q13-sol-s02",
            "math": "\\frac{58300}{298.15}+8.314462\\ln 0.1420 \\approx 179.31",
            "note": "Equivalently ΔS° = ΔH°/T + R ln K (J mol⁻¹ K⁻¹), and T = ΔH°/ΔS°."
          },
          {
            "id": "q13-sol-s03",
            "math": "0.1420\\,e^{-\\frac{58300}{8.314462}\\left(\\frac{1}{340.0}-\\frac{1}{298.15}\\right)} \\approx 2.56730",
            "note": "(b) K° at 340.0 K."
          },
          {
            "id": "q13-sol-s04",
            "math": "4x^2+2.56730x-0.400\\cdot2.56730=0",
            "note": "(c) ICE: P(N₂O₄) = 0.400 − x, P(NO₂) = 2x, K = 4x²/(0.400 − x)."
          },
          {
            "id": "q13-sol-s05",
            "math": "\\frac{-2.56730+\\sqrt{2.56730^2+16\\cdot0.400\\cdot2.56730}}{8} \\approx 0.278850",
            "note": "Positive root (bar)."
          },
          {
            "id": "q13-sol-s06",
            "math": "\\frac{4\\cdot0.278850^2}{0.400-0.278850} \\approx 2.56730",
            "note": "Check: the root reproduces K°."
          },
          {
            "id": "q13-sol-s07",
            "math": "0.400+0.278850 \\approx 0.6788",
            "note": "Total pressure P = 0.400 + x (bar)."
          },
          {
            "id": "q13-sol-s08",
            "math": "\\frac{0.278850}{0.400} \\approx 0.6971",
            "note": "Fraction dissociated α = x/0.400."
          }
        ],
        "answer": "T=325.1\\ \\mathrm K;\\quad K^\\circ(340.0\\ \\mathrm K)=2.567;\\quad P_{tot}=0.679\\ \\mathrm{bar};\\quad \\alpha=0.697",
        "source": {
          "kind": "manual"
        }
      }
    },
