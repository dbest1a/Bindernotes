{
  "question": 16,
  "title": "Q16 NMR structure elucidation",
  "subject": "Chemistry",
  "modules": [
    {
      "id": "q16-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q16 · C₈H₁₄O₂ from IR, MS, ¹H and ¹³C NMR",
        "problem": "IR 1720, 1658, 968 cm$^{-1}$, no O–H; MS $m/z$ 142 (M$^+$), base 69; $^1$H: 6.97 dq (15.5, 6.9), 5.86 dq (15.5, 1.7), 3.92 d 2H, 1.95 m 1H, 1.88 dd 3H, 0.94 d 6H; $^{13}$C: 166.7, 144.5, 122.8, 70.5, 27.9, 19.1, 18.0.",
        "steps": [
          {
            "id": "q16-sol-s01",
            "math": "\\frac{2\\cdot8+2-14}{2} = 2",
            "note": "Degree of unsaturation 2: one C=O (IR 1720, ¹³C 166.7, conjugated ester) and one C=C (IR 1658, ¹³C 144.5 and 122.8)."
          },
          {
            "id": "q16-sol-s02",
            "math": "8\\cdot12.011+14\\cdot1.008+2\\cdot15.999 \\approx 142.198",
            "note": "Molar mass matches M⁺ 142."
          },
          {
            "id": "q16-sol-s03",
            "math": "4\\cdot12+5\\cdot1+16 = 69",
            "note": "Base peak m/z 69 = C₄H₅O⁺, the crotonyl acylium CH₃CH=CH–C≡O⁺."
          },
          {
            "id": "q16-sol-s04",
            "math": "15.5 > 11.5",
            "note": "δ 6.97 dq couples to one vinyl H (15.5 Hz) and a CH₃ (6.9 Hz): the β-H of an α,β-unsaturated ester. ³J = 15.5 Hz means the vinyl hydrogens are trans, so E (Z-crotonates show about 11.5 Hz). IR 968 cm⁻¹ (trans CH=CH wag) agrees."
          },
          {
            "id": "q16-sol-s05",
            "math": "2+6 = 8,\\quad 8+1 = 9",
            "note": "δ 1.95 is coupled to OCH₂ (2 H) and two CH₃ (6 H): n + 1 = 9 lines, a nonet. Isobutyl group: OCH₂ d 3.92, CH 1.95, 2 × CH₃ d 0.94."
          },
          {
            "id": "q16-sol-s06",
            "math": "8-1 = 7",
            "note": "Seven ¹³C signals for eight carbons: the two isobutyl methyls are equivalent (19.1)."
          },
          {
            "id": "q16-sol-s07",
            "math": "3+1+1+2+1+6 = 14",
            "note": "Integrations account for all 14 H: 1.88 (3H), 6.97, 5.86, 3.92 (2H), 1.95, 0.94 (6H)."
          }
        ],
        "answer": "\\mathrm{CH_3CH{=}CHC({=}O)OCH_2CH(CH_3)_2}:\\ \\text{2-methylpropyl }(E)\\text{-but-2-enoate (isobutyl }(E)\\text{-crotonate)}",
        "source": {
          "kind": "manual"
        }
      }
    },
    {
