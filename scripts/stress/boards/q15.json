{
  "question": 15,
  "title": "Q15 E2 stereochemistry",
  "subject": "Chemistry",
  "modules": [
    {
      "id": "q15-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 540,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q15 · Anti-periplanar E2",
        "problem": "(1S,2R)-1-Bromo-2-methyl-1-phenylbutane + NaOEt/EtOH, anti-periplanar E2 only. Newman projection, curved arrows, and the product with its E/Z descriptor.",
        "steps": [
          {
            "id": "q15-sol-s01",
            "math": "\\mathrm{Br} > \\mathrm{Ph} > \\mathrm{C2} > \\mathrm{H}",
            "note": "CIP at C1: Ph is (C,C,C) and C2 is (C,C,H). The molecule card shows the drawn (1S,2R) labels."
          },
          {
            "id": "q15-sol-s02",
            "math": "\\mathrm{C1} > \\mathrm{Et} > \\mathrm{CH_3} > \\mathrm{H}",
            "note": "CIP at C2: C1 carries (Br,C,H)."
          },
          {
            "id": "q15-sol-s03",
            "math": "\\frac{2\\cdot11+2-15-1}{2} = 4",
            "note": "Substrate C₁₁H₁₅Br: degree of unsaturation 4 (the ring)."
          },
          {
            "id": "q15-sol-s04",
            "math": "11\\cdot12.011+15\\cdot1.008+79.904 \\approx 227.144",
            "note": "Substrate molar mass (g/mol); compare the molecule card."
          },
          {
            "id": "q15-sol-s05",
            "math": "\\frac{2\\cdot11+2-14}{2} = 5",
            "note": "Product C₁₁H₁₄: one more degree of unsaturation, the new C=C."
          },
          {
            "id": "q15-sol-s06",
            "math": "\\theta_{\\mathrm{H}}-\\theta_{\\mathrm{Br}} = 180^\\circ",
            "note": "Only C2 bears a β-hydrogen, and it has one H: it must sit at 180° to Br (anti-periplanar). With C1 front (Br 0°, Ph 120°, H 240°) and C2 back (2R: H 180°, Et 300°, CH₃ 60°)."
          },
          {
            "id": "q15-sol-s07",
            "math": "\\left|120-60\\right| = 60,\\quad \\left|300-240\\right| = 60",
            "note": "Groups 60° apart end up cis: Ph cis to CH₃, and H cis to Et."
          },
          {
            "id": "q15-sol-s08",
            "math": "\\mathrm{Ph} > \\mathrm{H},\\quad \\mathrm{Et} > \\mathrm{CH_3}",
            "note": "Higher priorities on the alkene: Ph (on C1) and Et (on C2). They are trans, so the alkene is E."
          }
        ],
        "answer": "(E)\\text{-2-methyl-1-phenylbut-1-ene}\\ =\\ [(E)\\text{-2-methylbut-1-en-1-yl}]\\text{benzene}",
        "source": {
          "kind": "manual"
        }
      }
    },
