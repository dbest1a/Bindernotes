{
  "question": 9,
  "title": "Q9 Exact pH of Na2HA",
  "subject": "Chemistry",
  "modules": [
    {
      "id": "q9-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q9 · Exact pH of 2.00 mM Na₂HA",
        "problem": "H$_3$A: p$K_{a1}=2.25$, p$K_{a2}=7.05$, p$K_{a3}=12.05$. Find the pH of $2.00\\times10^{-3}$ M Na$_2$HA from the full charge balance (3 d.p.).",
        "steps": [
          {
            "id": "q9-sol-s01",
            "math": "2C+h = C(\\alpha_1+2\\alpha_2+3\\alpha_3)+\\frac{K_w}{h}",
            "note": "Charge balance with [Na⁺] = 2C. α are the species fractions, denominator D = h³ + K₁h² + K₁K₂h + K₁K₂K₃."
          },
          {
            "id": "q9-sol-s02",
            "math": "h+C\\alpha_1+2C\\alpha_0 = C\\alpha_3+\\frac{K_w}{h}",
            "note": "Subtract the mass balance: proton condition [H⁺] + [H₂A⁻] + 2[H₃A] = [A³⁻] + [OH⁻]. Solved numerically: pH = 9.13818."
          },
          {
            "id": "q9-sol-s03",
            "math": "\\frac{10^{-9.13818}}{10^{-7.05}} \\approx 0.0081624",
            "note": "[H₂A⁻]/[HA²⁻] = h/K₂ at the solution."
          },
          {
            "id": "q9-sol-s04",
            "math": "\\frac{10^{-12.05}}{10^{-9.13818}} \\approx 0.0012251",
            "note": "[A³⁻]/[HA²⁻] = K₃/h."
          },
          {
            "id": "q9-sol-s05",
            "math": "\\frac{2000}{1+\\frac{10^{-9.13818}}{10^{-7.05}}+\\frac{10^{-12.05}}{10^{-9.13818}}+\\frac{10^{-2\\cdot9.13818}}{10^{-2.25}\\cdot10^{-7.05}}} \\approx 1981.4",
            "note": "[HA²⁻] in µM (C = 2000 µM)."
          },
          {
            "id": "q9-sol-s06",
            "math": "1981.4\\cdot0.0081624 \\approx 16.17",
            "note": "[H₂A⁻] in µM."
          },
          {
            "id": "q9-sol-s07",
            "math": "1981.4\\cdot0.0012251 \\approx 2.427",
            "note": "[A³⁻] in µM."
          },
          {
            "id": "q9-sol-s08",
            "math": "10^{6}\\cdot\\frac{10^{-14}}{10^{-9.13818}} \\approx 13.75",
            "note": "[OH⁻] in µM: much larger than [A³⁻], which is why the shortcut fails."
          },
          {
            "id": "q9-sol-s09",
            "math": "10^{6}\\cdot10^{-9.13818}+16.17+2\\cdot0.00000209 \\approx 2.427+13.75",
            "note": "Proton condition balances in µM: left (H⁺ + H₂A⁻ + 2H₃A) = right (A³⁻ + OH⁻)."
          },
          {
            "id": "q9-sol-s10",
            "math": "\\frac{7.05+12.05}{2} = 9.55",
            "note": "Contrast: the naive (pK₂ + pK₃)/2 is badly wrong here."
          },
          {
            "id": "q9-sol-s11",
            "math": "-\\log_{10}\\sqrt{\\frac{10^{-7.05}\\left(10^{-12.05}\\cdot0.002+10^{-14}\\right)}{10^{-7.05}+0.002}} \\approx 9.1399",
            "note": "Contrast: the improved formula gives 9.140, which misses at 3 d.p."
          }
        ],
        "answer": "\\mathrm{pH}=9.138",
        "source": {
          "kind": "manual"
        }
      }
    },
