  "subject": "Math",
  "modules": [
    {
      "id": "q1-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q1 · Keyhole contour",
        "problem": "Evaluate $I=\\int_0^\\infty \\dfrac{x^{1/3}}{(x+1)(x+4)}\\,dx$ with a keyhole contour, branch cut on the positive real axis ($0<\\arg z<2\\pi$).",
        "steps": [
          {
            "id": "q1-sol-s01",
            "math": "\\left|\\int_{|z|=\\varepsilon} f\\,dz\\right| \\le 2\\pi\\varepsilon\\cdot\\frac{\\varepsilon^{1/3}}{(1-\\varepsilon)(4-\\varepsilon)}",
            "note": "ML estimate, small circle: the bound is about (π/2)ε^(4/3), which tends to 0."
          },
          {
            "id": "q1-sol-s02",
            "math": "\\left|\\int_{|z|=R} f\\,dz\\right| \\le 2\\pi R\\cdot\\frac{R^{1/3}}{(R-1)(R-4)}",
            "note": "ML estimate, large circle: the bound behaves like 2πR^(−2/3), which tends to 0."
          },
          {
            "id": "q1-sol-s03",
            "math": "(1-e^{2\\pi i/3})\\,I = 2\\pi i\\,(\\operatorname{Res}_{-1}+\\operatorname{Res}_{-4})",
            "note": "The upper edge gives I; on the lower edge z^(1/3) = x^(1/3)e^(2πi/3), traversed inward."
          },
          {
            "id": "q1-sol-s04",
            "math": "\\frac{e^{i\\pi/3}}{(-1)+4} = \\frac{1}{6}+\\frac{\\sqrt{3}}{6}i",
            "note": "Residue at z = −1: (−1)^(1/3) = e^(iπ/3) on this branch, divided by (z + 4) at z = −1."
          },
          {
            "id": "q1-sol-s05",
            "math": "\\frac{4^{1/3}e^{i\\pi/3}}{(-4)+1} = -\\frac{4^{1/3}}{3}e^{i\\pi/3}",
            "note": "Residue at z = −4: (−4)^(1/3) = 4^(1/3)e^(iπ/3), divided by (z + 1) at z = −4."
          },
          {
            "id": "q1-sol-s06",
            "math": "\\frac{e^{i\\pi/3}}{3}-\\frac{4^{1/3}e^{i\\pi/3}}{3} = \\frac{e^{i\\pi/3}(1-4^{1/3})}{3}",
            "note": "Sum of the residues."
          },
          {
            "id": "q1-sol-s07",
            "math": "1-e^{2\\pi i/3} = -i\\sqrt{3}\\,e^{i\\pi/3}",
            "note": "Factor the left-hand coefficient."
          },
          {
            "id": "q1-sol-s08",
            "math": "\\frac{2\\pi i}{-i\\sqrt{3}\\,e^{i\\pi/3}}\\cdot\\frac{e^{i\\pi/3}(1-4^{1/3})}{3} = \\frac{2\\pi(4^{1/3}-1)}{3\\sqrt{3}}",
            "note": "Divide: the phases e^(iπ/3) cancel and I is real, as it must be."
          },
          {
            "id": "q1-sol-s09",
            "math": "\\frac{2\\pi(4^{1/3}-1)}{3\\sqrt{3}} \\approx 0.710285",
            "note": "Decimal value to 6 significant figures."
          },
          {
            "id": "q1-sol-s10",
            "math": "\\int_0^{\\infty}\\frac{x^{1/3}}{(x+1)(x+4)}\\,dx \\approx 0.710285",
            "note": "Cross-check: direct numerical quadrature of the original integral."
          },
          {
            "id": "q1-sol-s11",
            "math": "\\frac{\\pi\\,(1^{1/3}-4^{1/3})}{(4-1)\\sin(4\\pi/3)} = \\frac{2\\pi(4^{1/3}-1)}{3\\sqrt{3}}",
            "note": "Cross-check with the general formula π(b^(a−1) − c^(a−1))/((c − b) sin πa), a = 4/3, b = 1, c = 4."
          }
        ],
        "answer": "I=\\dfrac{2\\pi\\left(\\sqrt[3]{4}-1\\right)}{3\\sqrt{3}}\\approx 0.710285",
        "source": {
          "kind": "manual"
        }
      }
    },
