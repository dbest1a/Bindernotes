      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q7 · 2^m + 5^n is a perfect square",
        "problem": "Find all nonnegative integers $(m,n)$ with $2^m+5^n=k^2$, and prove there are no others.",
        "steps": [
          {
            "id": "q7-sol-s01",
            "math": "(3-1)(3+1) = 2^3",
            "note": "Case n = 0: (k − 1)(k + 1) = 2^m. Two powers of 2 that differ by 2 must be 2 and 4, so k = 3 and m = 3."
          },
          {
            "id": "q7-sol-s02",
            "math": "2^3+5^0 = 3^2",
            "note": "So (m, n) = (3, 0) is a solution."
          },
          {
            "id": "q7-sol-s03",
            "math": "1^2\\bmod 5 = 1,\\quad 2^2\\bmod 5 = 4,\\quad 3^2\\bmod 5 = 4,\\quad 4^2\\bmod 5 = 1",
            "note": "Case n ≥ 1: k² ≡ 2^m (mod 5) must be 1 or 4 …"
          },
          {
            "id": "q7-sol-s04",
            "math": "2^1\\bmod 5 = 2,\\quad 2^2\\bmod 5 = 4,\\quad 2^3\\bmod 5 = 3,\\quad 2^4\\bmod 5 = 1",
            "note": "… and 2^m mod 5 cycles 2, 4, 3, 1, so m is even."
          },
          {
            "id": "q7-sol-s05",
            "math": "(1+(-1)^2)\\bmod 3 = 2",
            "note": "Mod 3 with m even: 2^m + 5^n ≡ 1 + (−1)^n. If n were even this is 2, not a square mod 3 (squares are 0, 1). So n is odd."
          },
          {
            "id": "q7-sol-s06",
            "math": "5^1\\bmod 8 = 5,\\quad 5^3\\bmod 8 = 5,\\quad 5^5\\bmod 8 = 5",
            "note": "Mod 8 with m ≥ 3 and n odd: 2^m + 5^n ≡ 5, but squares mod 8 are 0, 1, 4. So m ∈ {0, 2}."
          },
          {
            "id": "q7-sol-s07",
            "math": "(k-1)(k+1) = 5^n",
            "note": "m = 0: both factors would be powers of 5 differing by 2. Impossible (5^a − 5^b is a multiple of 4, or 0)."
          },
          {
            "id": "q7-sol-s08",
            "math": "(3-2)(3+2) = 5^1",
            "note": "m = 2: (k − 2)(k + 2) = 5^n; powers of 5 differing by 4 are 1 and 5, so k = 3, n = 1."
          },
          {
            "id": "q7-sol-s09",
            "math": "2^2+5^1 = 3^2",
            "note": "So (m, n) = (2, 1) is a solution."
          }
        ],
        "answer": "(m,n)=(3,0)\\ \\text{and}\\ (2,1),\\ \\text{both giving } 9;\\ \\text{no others}",
        "source": {
          "kind": "manual"
        }
      }
    },
