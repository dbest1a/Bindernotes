      "solution": {
        "version": 1,
        "title": "Q10 · 25.00 mL of 0.0800 M H₂A vs 0.1000 M NaOH",
        "problem": "p$K_{a1}=3.40$, p$K_{a2}=7.85$. Exact charge balance with dilution: pH at 0, 10, 20, 30, 40, 45 mL, and both equivalence volumes.",
        "steps": [
          {
            "id": "q10-sol-s01",
            "math": "\\frac{25.00\\cdot0.0800}{0.1000} = 20.00,\\quad 2\\cdot20.00 = 40.00",
            "note": "2.000 mmol H₂A: V_eq1 = 20.00 mL and V_eq2 = 40.00 mL."
          },
          {
            "id": "q10-sol-s02",
            "math": "\\mathrm{Na}+h = C_A\\frac{K_1h+2K_1K_2}{h^2+K_1h+K_1K_2}+\\frac{K_w}{h}",
            "note": "Charge balance at volume V: C_A = 2.000/(25 + V) M, [Na⁺] = 0.1000·V/(25 + V) M. Each line below is this balance in mM at the solved pH, with the fraction divided through by K₁h: (1 + 2K₂/h)/(h/K₁ + 1 + K₂/h)."
          },
          {
            "id": "q10-sol-s03",
            "math": "0+10^{0.7362} \\approx \\frac{2000}{25}\\cdot\\frac{1+2\\cdot10^{-5.5862}}{10^{1.1362}+1+10^{-5.5862}}+10^{-8.7362}",
            "note": "V = 0.00 mL: pH = 2.2638 → 2.26."
          },
          {
            "id": "q10-sol-s04",
            "math": "\\frac{100\\cdot10}{35}+10^{-0.4117} \\approx \\frac{2000}{35}\\cdot\\frac{1+2\\cdot10^{-4.4383}}{10^{-0.0117}+1+10^{-4.4383}}+10^{-7.5883}",
            "note": "V = 10.00 mL: pH = 3.4117 → 3.41."
          },
          {
            "id": "q10-sol-s05",
            "math": "\\frac{100\\cdot20}{45}+10^{-2.6270} \\approx \\frac{2000}{45}\\cdot\\frac{1+2\\cdot10^{-2.2230}}{10^{-2.2270}+1+10^{-2.2230}}+10^{-5.3730}",
            "note": "V = 20.00 mL: pH = 5.6270 → 5.63."
          },
          {
            "id": "q10-sol-s06",
            "math": "\\frac{100\\cdot30}{55}+10^{-4.8500} \\approx \\frac{2000}{55}\\cdot\\frac{1+2\\cdot10^{0.0000}}{10^{-4.4500}+1+10^{0.0000}}+10^{-3.1500}",
            "note": "V = 30.00 mL: pH = 7.8500 → 7.85."
          },
          {
            "id": "q10-sol-s07",
            "math": "\\frac{100\\cdot40}{65}+10^{-7.1680} \\approx \\frac{2000}{65}\\cdot\\frac{1+2\\cdot10^{2.3180}}{10^{-6.7680}+1+10^{2.3180}}+10^{-0.8320}",
            "note": "V = 40.00 mL: pH = 10.1680 → 10.17."
          },
          {
            "id": "q10-sol-s08",
            "math": "\\frac{100\\cdot45}{70}+10^{-8.8540} \\approx \\frac{2000}{70}\\cdot\\frac{1+2\\cdot10^{4.0040}}{10^{-8.4540}+1+10^{4.0040}}+10^{0.8540}",
            "note": "V = 45.00 mL: pH = 11.8540 → 11.85."
          },
          {
            "id": "q10-sol-s09",
            "math": "3.40+\\log_{10}\\frac{1.000}{1.000} = 3.40,\\quad \\frac{3.40+7.85}{2} = 5.625",
            "note": "Shortcuts (Henderson at 10 mL, amphiprotic average at 20 mL) are close but not exact: K₁ is large relative to C."
          }
        ],
        "answer": "\\mathrm{pH}: 2.26,\\ 3.41,\\ 5.63,\\ 7.85,\\ 10.17,\\ 11.85\\ \\text{at}\\ 0,10,20,30,40,45\\ \\text{mL};\\ V_{eq}=20.00,\\ 40.00\\ \\text{mL}",
        "source": {
          "kind": "manual"
        }
      }
    },
