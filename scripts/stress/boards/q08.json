  "question": 8,
  "title": "Q8 Incenter to nine-point center",
  "subject": "Math",
  "modules": [
    {
      "id": "q8-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q8 · Distance IN (Feuerbach)",
        "problem": "Triangle with $AB=7$, $BC=8$, $CA=9$. $I$ = incenter, $N$ = nine-point center (midpoint of $OH$). Find $IN$ exactly.",
        "steps": [
          {
            "id": "q8-sol-s01",
            "math": "2^2+(3\\sqrt5)^2 = 7^2,\\quad (2-8)^2+(3\\sqrt5)^2 = 9^2",
            "note": "Coordinates B = (0,0), C = (8,0), A = (2, 3√5) give AB = 7 and AC = 9."
          },
          {
            "id": "q8-sol-s02",
            "math": "\\sqrt{12\\cdot(12-8)(12-9)(12-7)} = 12\\sqrt5",
            "note": "Heron: s = 12, area K = 12√5."
          },
          {
            "id": "q8-sol-s03",
            "math": "\\frac{12\\sqrt5}{12} = \\sqrt5",
            "note": "Inradius r = K/s."
          },
          {
            "id": "q8-sol-s04",
            "math": "\\frac{7\\cdot8\\cdot9}{4\\cdot12\\sqrt5} = \\frac{21\\sqrt5}{10}",
            "note": "Circumradius R = abc/(4K)."
          },
          {
            "id": "q8-sol-s05",
            "math": "4^2+\\left(\\frac{11\\sqrt5}{10}\\right)^2 = \\left(\\frac{21\\sqrt5}{10}\\right)^2",
            "note": "O = (4, 11√5/10) is at distance R from B …"
          },
          {
            "id": "q8-sol-s06",
            "math": "(4-2)^2+\\left(\\frac{11\\sqrt5}{10}-3\\sqrt5\\right)^2 = \\left(\\frac{21\\sqrt5}{10}\\right)^2",
            "note": "… and from A."
          },
          {
            "id": "q8-sol-s07",
            "math": "3\\sqrt5-2\\cdot\\frac{11\\sqrt5}{10} = \\frac{4\\sqrt5}{5},\\quad 2+0+8-2\\cdot4 = 2",
            "note": "H = A + B + C − 2O = (2, 4√5/5), on the altitude x = 2."
          },
          {
            "id": "q8-sol-s08",
            "math": "\\frac12\\left(\\frac{11\\sqrt5}{10}+\\frac{4\\sqrt5}{5}\\right) = \\frac{19\\sqrt5}{20},\\quad \\frac{4+2}{2} = 3",
            "note": "N = (O + H)/2 = (3, 19√5/20)."
          },
          {
            "id": "q8-sol-s09",
            "math": "\\frac{8\\cdot2+9\\cdot0+7\\cdot8}{24} = 3,\\quad \\frac{8\\cdot3\\sqrt5}{24} = \\sqrt5",
            "note": "I = (aA + bB + cC)/(a + b + c) = (3, √5), with a = BC = 8, b = CA = 9, c = AB = 7."
          },
          {
            "id": "q8-sol-s10",
            "math": "\\sqrt5-\\frac{19\\sqrt5}{20} = \\frac{\\sqrt5}{20}",
            "note": "I and N both lie on x = 3, so IN is the difference of the y-coordinates."
          },
          {
            "id": "q8-sol-s11",
            "math": "\\frac12\\cdot\\frac{21\\sqrt5}{10}-\\sqrt5 = \\frac{\\sqrt5}{20}",
            "note": "Feuerbach check: the incircle is internally tangent to the nine-point circle, so IN = R/2 − r."
          },
          {
            "id": "q8-sol-s12",
            "math": "(4-3)^2+\\left(\\frac{11\\sqrt5}{10}-\\sqrt5\\right)^2 = \\frac{21\\sqrt5}{10}\\left(\\frac{21\\sqrt5}{10}-2\\sqrt5\\right)",
            "note": "Side check, Euler: OI² = R(R − 2r) = 21/20."
          },
          {
            "id": "q8-sol-s13",
            "math": "\\frac{\\sqrt5}{20} \\approx 0.111803",
            "note": "Decimal value."
          }
        ],
        "answer": "IN=\\dfrac{\\sqrt5}{20}\\approx 0.111803",
        "source": {
          "kind": "manual"
        }
      }
    },
