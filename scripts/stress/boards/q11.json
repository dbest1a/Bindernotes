{
  "question": 11,
  "title": "Q11 AgCl in ammonia with chloride",
  "subject": "Chemistry",
  "modules": [
    {
      "id": "q11-sol",
      "moduleId": "solution-steps",
      "title": "Worked solution",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 764,
      "anchorMode": "board-fixed-size",
      "solution": {
        "version": 1,
        "title": "Q11 · AgCl in 0.250 M NH₃ + 0.0100 M NaCl",
        "problem": "$K_{sp}=1.9\\times10^{-10}$, $\\log\\beta_1=3.25$, $\\log\\beta_2=7.10$. Find the molar solubility $S$ (3 s.f.) and the fraction of dissolved Ag as Ag(NH$_3$)$_2^+$ (4 s.f.).",
        "steps": [
          {
            "id": "q11-sol-s01",
            "math": "S = \\frac{K_{sp}}{0.0100+S}\\left(1+\\beta_1L+\\beta_2L^2\\right)",
            "note": "Silver balance; [Cl⁻] = 0.0100 + S and L = free NH₃."
          },
          {
            "id": "q11-sol-s02",
            "math": "0.250 = L+\\frac{K_{sp}}{0.0100+S}\\left(\\beta_1L+2\\beta_2L^2\\right)",
            "note": "Ammonia balance, counting NH₃ bound in the complexes. Solved together: S = 7.53411 mM, L = 0.234936 M."
          },
          {
            "id": "q11-sol-s03",
            "math": "10^{9}\\cdot\\frac{1.9\\times10^{-10}}{0.0100+7.53411\\times10^{-3}} \\approx 10.836",
            "note": "[Ag⁺] in nM."
          },
          {
            "id": "q11-sol-s04",
            "math": "10^{3}\\cdot10.836\\times10^{-9}\\left(1+10^{3.25}\\cdot0.234936+10^{7.10}\\cdot0.234936^2\\right) \\approx 7.53411",
            "note": "Silver balance holds (mM): S = [Ag⁺](1 + β₁L + β₂L²)."
          },
          {
            "id": "q11-sol-s05",
            "math": "10^{3}\\left(0.234936+10.836\\times10^{-9}\\left(10^{3.25}\\cdot0.234936+2\\cdot10^{7.10}\\cdot0.234936^2\\right)\\right) \\approx 250.0",
            "note": "Ammonia balance holds (mM)."
          },
          {
            "id": "q11-sol-s06",
            "math": "\\frac{10^{7.10}\\cdot0.234936^2}{1+10^{3.25}\\cdot0.234936+10^{7.10}\\cdot0.234936^2} \\approx 0.99940",
            "note": "Fraction of dissolved silver present as Ag(NH₃)₂⁺."
          },
          {
            "id": "q11-sol-s07",
            "math": "10^{4}\\cdot\\frac{10^{3.25}\\cdot0.234936}{1+10^{3.25}\\cdot0.234936+10^{7.10}\\cdot0.234936^2} \\approx 6.01",
            "note": "Ag(NH₃)⁺ fraction ×10⁴ (≈ 6.0 × 10⁻⁴); free Ag⁺ is about 1.4 × 10⁻⁶."
          }
        ],
        "answer": "S=7.53\\times10^{-3}\\ \\mathrm{M};\\quad \\text{fraction as Ag(NH}_3)_2^+=0.9994",
        "source": {
          "kind": "manual"
        }
      }
    },
