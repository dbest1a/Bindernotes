{
  "name": "binder-notes",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader runner --host 127.0.0.1",
    "build": "node scripts/build-client.mjs",
    "preview": "vite preview --config vite.config.ts --configLoader runner --host 127.0.0.1",
    "test": "vitest --run --config vite.config.ts --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false && tsc --noEmit -p tsconfig.server.json --pretty false",
    "scan:build": "node scripts/scan-build-assets.mjs",
    "seed:system": "tsx scripts/seed-system.ts",
    "repair:system": "tsx scripts/repair-system-content.ts",
    "repair:system:apply": "tsx scripts/repair-system-content.ts --apply",
    "verify:system": "tsx scripts/verify-system-content.ts",
    "verify:system-seed": "tsx scripts/verify-system-seed.ts",
    "seed:math": "tsx scripts/seed-math.ts",
    "verify:math-seed": "tsx scripts/verify-math-seed.ts",
    "cleanup:placeholders": "tsx scripts/cleanup-workspace-placeholders.ts",
    "verify:supabase-grants": "node scripts/check-supabase-data-api-grants.mjs",
    "verify:auth:live": "node scripts/verify-live-auth.mjs --url https://www.bindernotes.com/auth",
    "verify:client-env": "node scripts/client-env-guard.mjs --mode production --check-output dist",
    "lint": "eslint src server api e2e scripts/database scripts/ci scripts/build-client.mjs scripts/client-env-guard.mjs scripts/scan-build-assets.mjs eslint.config.mjs",
    "format:check": "node scripts/ci/quality-files.mjs",
    "format": "node scripts/ci/quality-files.mjs --write",
    "test:e2e": "playwright test",
    "test:db": "node scripts/database/run-runtime-tests.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.99.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.1",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.5.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "prettier": "3.9.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "uuid": "14.0.0",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
